#include <ctime>

char getUserChoice();
char getComputerChoice();
void showChoice(char choice);
void chooseWinner(char player, char computer);


int main() {
    srand(static_cast<unsigned int>(time(NULL)));
    char player;
    char computer;
    char answer;
    
    do{
        player = getUserChoice();
        std::cout << "you choose: ";
        showChoice(player);
    
        computer = getComputerChoice();
