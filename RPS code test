char getUserChoice(){
    
    char player;
    std::cout << "Rock Paper Scissor Minigame" << '\n';
    do{
        std::cout << "*Choose one of below*" << '\n';
        std::cout << "*********" << '\n';
        std::cout << "'r' for rock" << '\n';
        std::cout << "'p' for paper" << '\n';
        std::cout << "'s' for scissor" << '\n';
        std::cin >> player;
    }while (player != 'r' && player != 'p' && player != 's');
    
    
    return player;
}
char getComputerChoice(){
    
    int num = rand() % 3 + 1;
    
    if(num == 1) return 'r';
    if(num == 2) return 'p';
    return 's';
}
void showChoice(char choice){
    
    switch(choice){
        case 'r': std::cout << "Rock" << std::endl;
            break;
        case 'p': std::cout << "Paper" << std::endl;
            break;
        case 's': std::cout << "Scissor" << std::endl;
            break;
    }
}
